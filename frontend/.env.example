# Copy this file to `.env.local` (git-ignored) to override per-environment.
# These are exposed to the browser, so do not put secrets here.

# Base URL of the backend API (used for creating + resolving short links).
NEXT_PUBLIC_BACKEND_URL=https://app.ku2.me

# Domain shown to users for the generated short link (no protocol).
NEXT_PUBLIC_SHORT_DOMAIN=ku2.me
