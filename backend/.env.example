# Copy this file to `.env` (git-ignored) and adjust as needed.
#
# The defaults below match the local docker-compose stack
# (`docker compose up -d` brings up Postgres on 5432 and Redis on 6379),
# so a fresh checkout can run fully offline.
#
# In production these point at managed services instead:
#   DATABASE_URL / DIRECT_URL -> Supabase (pooled vs. direct)
#   REDIS_URL                 -> Upstash (rediss:// — TLS is auto-enabled)

# Pooled connection used by the app at runtime.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/urlshortener"
# Direct connection used by Prisma for migrations.
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/urlshortener"

# Port the Express server listens on.
PORT=3001

# Redis connection. Local: redis://  Prod (Upstash): rediss://
REDIS_URL="redis://localhost:6379"

# Optional Upstash REST credentials (production only).
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
